# ============================================================================
# KewalInvest - Production Environment Configuration
# ============================================================================
# IMPORTANT: This is a template file.
# Run ./configure.sh to auto-generate secure passwords and secrets.
# Or manually copy this to .env and fill in all values.
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# DOCKER & DEPLOYMENT
# ============================================================================
# Docker image registry (leave as default for Docker Hub)
DOCKER_REGISTRY=vikuna
# Image tag/version (latest, v1.0.0, etc.)
IMAGE_TAG=latest
# Data storage path (where all volumes are stored)
DATA_PATH=./data

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
# Network subnet for Docker network
NETWORK_SUBNET=172.20.0.0/16

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
DB_NAME=kewalinvest
DB_USER=kewal_admin
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_32_CHARS
DB_PORT=5432
DB_MAX_CONNECTIONS=100
DB_SHARED_BUFFERS=256MB

# ============================================================================
# REDIS CONFIGURATION (Currently disabled - uncomment to enable)
# ============================================================================
# REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# REDIS_PORT=6379

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
BACKEND_PORT=8080
CORS_ORIGIN=http://localhost:3000

# JWT Authentication
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARACTERS_LONG
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# Data Encryption Key (MUST be exactly 32 characters)
ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_CHARS_KEY!

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/UserFiles

# Backend Resource Limits
BACKEND_MEMORY_LIMIT=2G
BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_RESERVATION=512M
BACKEND_CPU_RESERVATION=0.5

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_PORT=3000
FRONTEND_HOST=localhost

# API URLs (for React build-time)
REACT_APP_API_URL=http://localhost:8080

# Frontend Resource Limits
FRONTEND_MEMORY_LIMIT=512M
FRONTEND_CPU_LIMIT=1
FRONTEND_MEMORY_RESERVATION=128M
FRONTEND_CPU_RESERVATION=0.25

# ============================================================================
# N8N WORKFLOW AUTOMATION (Currently disabled - uncomment to enable)
# ============================================================================
# N8N_PORT=5678
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# N8N_WEBHOOK_URL=http://localhost:5678/
# N8N_EDITOR_BASE_URL=http://localhost:5678/

# n8n Authentication (Basic Auth)
# N8N_USER_MANAGEMENT_DISABLED=false
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_PASSWORD

# n8n Encryption Key (for credentials storage)
# N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY_32_CHARS

# n8n API Key (for backend integration)
# N8N_API_KEY=CHANGE_ME_N8N_API_KEY

# n8n Execution Settings
# N8N_EXECUTIONS_TIMEOUT=-1
# N8N_EXECUTIONS_TIMEOUT_MAX=3600
# N8N_METRICS=false

# ============================================================================
# PGADMIN (DATABASE MANAGEMENT UI)
# ============================================================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@kewalinvest.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ============================================================================
# TIMEZONE CONFIGURATION
# ============================================================================
# Set to your local timezone (e.g., Asia/Kolkata, America/New_York, Europe/London)
TIMEZONE=Asia/Kolkata

# ============================================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================================
# Uncomment and configure if needed

# Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@kewalinvest.com

# Backup Configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30

# Monitoring
# ENABLE_MONITORING=false
# MONITORING_PORT=9090

# ============================================================================
# NOTES
# ============================================================================
# 1. All CHANGE_ME values MUST be updated before deployment
# 2. Use strong, random passwords for all credentials
# 3. Encryption keys should be exactly 32 characters
# 4. Never commit the actual .env file to version control
# 5. Keep .env file secure and backed up safely
# 6. Run ./configure.sh to auto-generate secure values
# ============================================================================
