# Frontend Staging Environment Variables
# Copy this file to .env on staging deployment

# API Configuration
REACT_APP_API_URL=https://api-staging.yourdomain.com

# Environment
REACT_APP_ENV=staging

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_DEBUG=false

# Application Info
REACT_APP_NAME=Kewalinvest (Staging)
REACT_APP_VERSION=1.0.0
