# Backend Production Environment Variables
# SECURITY WARNING: Never commit this file with real credentials!

# Server Configuration
NODE_ENV=production
PORT=8080

# Database Configuration
DB_HOST=prod-db-host.example.com
DB_PORT=5432
DB_NAME=kewalinvest_prod
DB_USER=kewal_prod_user
DB_PASSWORD=REPLACE_WITH_SECURE_PRODUCTION_DB_PASSWORD

# JWT Authentication
# IMPORTANT: Use a strong random secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRY=24h

# CORS Configuration
CORS_ORIGIN=https://app.yourdomain.com

# API Keys (Production)
MARKET_DATA_API_KEY=REPLACE_WITH_PRODUCTION_API_KEY

# Logging
LOG_LEVEL=warn

# File Upload
MAX_FILE_SIZE=50mb
UPLOAD_DIR=/var/app/uploads

# Rate Limiting (Stricter in production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# Email Configuration
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=Kewalinvest <noreply@yourdomain.com>

# Security Headers
HELMET_ENABLED=true

# SSL/TLS
SSL_ENABLED=true
