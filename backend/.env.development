# Backend Development Environment Variables
# Copy this file to .env for local development

# Server Configuration
NODE_ENV=development
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kewalinvest_dev
DB_USER=kewal_admin
DB_PASSWORD=kewal_dev_pass_2024

# JWT Authentication
JWT_SECRET=dev_jwt_secret_key_change_in_production_12345
JWT_EXPIRY=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# API Keys (Development)
MARKET_DATA_API_KEY=your_development_api_key

# Logging
LOG_LEVEL=debug

# File Upload
MAX_FILE_SIZE=50mb
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
