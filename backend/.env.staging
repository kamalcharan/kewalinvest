# Backend Staging Environment Variables
# Copy this file to .env on staging server

# Server Configuration
NODE_ENV=staging
PORT=8080

# Database Configuration
DB_HOST=staging-db-host.example.com
DB_PORT=5432
DB_NAME=kewalinvest_staging
DB_USER=kewal_staging_user
DB_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD

# JWT Authentication
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRY=24h

# CORS Configuration
CORS_ORIGIN=https://staging.yourdomain.com

# API Keys (Staging)
MARKET_DATA_API_KEY=REPLACE_WITH_STAGING_API_KEY

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=50mb
UPLOAD_DIR=/var/app/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (if needed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=staging@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
